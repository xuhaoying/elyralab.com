name = "elyralab"
main = ".open-next/worker.js"
compatibility_date = "2026-06-01"
compatibility_flags = ["nodejs_compat", "global_fetch_strictly_public"]

[assets]
binding = "ASSETS"
directory = ".open-next/assets"

[[services]]
# Self-reference service binding required by OpenNext cache/revalidation.
binding = "WORKER_SELF_REFERENCE"
service = "elyralab"

[[r2_buckets]]
binding = "NEXT_INC_CACHE_R2_BUCKET"
bucket_name = "elyralab-opennext-cache"

[images]
binding = "IMAGES"

[vars]
# app
NEXT_PUBLIC_APP_URL = "https://elyralab.com"
NEXT_PUBLIC_APP_NAME = "ElyraLab"

# theme
NEXT_PUBLIC_THEME = "default"

# appearance
NEXT_PUBLIC_APPEARANCE = "system"
NEXT_PUBLIC_DEFAULT_LOCALE = "en"

# database
DATABASE_PROVIDER = "postgresql"
DB_SINGLETON_ENABLED = "true"
DB_MAX_CONNECTIONS = "1"
NEXT_INC_CACHE_R2_PREFIX = "incremental-cache"

# Configure secrets with `wrangler secret put`, not [vars]:
# - DATABASE_URL
# - AUTH_SECRET
# - AI_DISPATCH_TOKENS
# - CRON_SECRET
